{
  "id": "star_trek_quotes",
  "name": "Star Trek Quotes",
  "version": "1.1.3",
  "description": "Display random Star Trek quotes from TNG, Voyager, and DS9",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--star-trek-quotes",
  "documentation": "README.md",
  "icon": "star",
  "category": "entertainment",
  "min_refresh_seconds": 30,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Star Trek Quotes",
        "default": false
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to pick a new Star Trek quote",
        "default": 300,
        "minimum": 30,
        "maximum": 3600
      },
      "ratio": {
        "type": "string",
        "title": "Series Ratio",
        "description": "Weight ratio for TNG:Voyager:DS9 (e.g., 3:5:9)",
        "default": "3:5:9",
        "pattern": "^\\d+:\\d+:\\d+$"
      }
    }
  },
  "env_vars": [
    {
      "name": "STAR_TREK_QUOTES_ENABLED",
      "required": false,
      "description": "Enable Star Trek quotes feature",
      "default": "false"
    },
    {
      "name": "STAR_TREK_QUOTES_RATIO",
      "required": false,
      "description": "Weight ratio for TNG:Voyager:DS9",
      "default": "3:5:9"
    }
  ],
  "variables": {
    "groups": {
      "quote_data": {
        "label": "Quote"
      },
      "metadata": {
        "label": "Metadata"
      }
    },
    "simple": {
      "quote": {
        "description": "The Star Trek quote text",
        "type": "string",
        "max_length": 120,
        "group": "quote_data",
        "example": "Make it so."
      },
      "character": {
        "description": "Character who said the quote",
        "type": "string",
        "max_length": 15,
        "group": "quote_data",
        "example": "Picard"
      },
      "series": {
        "description": "Series abbreviation (tng, voyager, ds9)",
        "type": "string",
        "max_length": 7,
        "group": "metadata",
        "example": "tng"
      },
      "series_color": {
        "description": "Color code for the series",
        "type": "string",
        "max_length": 4,
        "group": "metadata",
        "example": "{67}"
      }
    }
  },
  "color_rules_schema": {
    "series": {
      "type": "match",
      "description": "Color based on Star Trek series",
      "default_rules": [
        {
          "condition": "==",
          "value": "tng",
          "color": "blue"
        },
        {
          "condition": "==",
          "value": "voyager",
          "color": "orange"
        },
        {
          "condition": "==",
          "value": "ds9",
          "color": "violet"
        }
      ]
    }
  },
  "fiestaboard_version": ">=2.10.0",
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "Star Trek Quotes displayed on a Vestaboard",
      "caption": "Display random Star Trek quotes from TNG, Voyager, and DS9",
      "primary": true
    }
  ],
  "teaser": "MAKE IT SO.",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}{68}",
        "THE NEEDS OF THE MANY",
        " OUTWEIGH THE NEEDS",
        "      OF THE FEW",
        "",
        "       - MR SPOCK"
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "{65}STAR TREK",
        "MAKE IT SO.",
        "- PICARD"
      ]
    }
  ],
  "demo": {
    "flagship": {
      "name": "Star Trek Quotes Demo",
      "template": [
        "",
        "{{star_trek_quotes.quote}}",
        "",
        "",
        "{{star_trek_quotes.character}}",
        "{{star_trek_quotes.series}} {{star_trek_quotes.series_color}}"
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": true
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "right",
          "wrap": false
        },
        {
          "alignment": "right",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "Star Trek (Note)",
      "template": [
        "{{star_trek_quotes.quote}}",
        "",
        "{{star_trek_quotes.character}}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
